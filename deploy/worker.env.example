# DevOps Safeguard — monitoring worker environment (EXAMPLE ONLY).
#
# Copy to /etc/devops-safeguard/worker.env on the EC2 host, fill in the real
# values, then:
#   sudo chown root:devops-safeguard /etc/devops-safeguard/worker.env
#   sudo chmod 600 /etc/devops-safeguard/worker.env
#
# NEVER commit the real file. It holds the service-role key, which bypasses
# row-level security by design and must never reach a browser bundle, a log,
# or version control (RULE.md 11).

# --- Required -------------------------------------------------------------
# The same Supabase project URL the Next.js app uses.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# The service-role key (Supabase dashboard > Project Settings > API).
# Newer projects may use the sb_secret_... key instead; either works.
SUPABASE_SERVICE_ROLE_KEY=put-the-service-role-key-here

# --- Optional tuning (defaults shown) -------------------------------------
# Set to "false" to stop monitoring without uninstalling the service.
MONITOR_WORKER_ENABLED=true
# Seconds between scheduler passes. Must be <= the smallest service
# intervalSec (10s) or checks run late.
MONITOR_WORKER_POLL_SECONDS=10
# Simultaneous checks. Each one is an outbound request to somebody's
# production endpoint; keep this small.
MONITOR_WORKER_CONCURRENCY=4
# Maximum projects considered per pass.
MONITOR_WORKER_BATCH_LIMIT=200
# Seconds a claim survives a crashed worker before it becomes claimable.
MONITOR_WORKER_LEASE_SECONDS=120
# Stable identity for this host in the logs and the services table.
MONITOR_WORKER_ID=worker-ec2
# Restrict to one project (debugging / single-project operation).
# MONITOR_WORKER_PROJECT_ID=
# One of: debug, info, warn, error.
LOG_LEVEL=info
