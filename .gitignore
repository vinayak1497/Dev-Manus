# =============================================================================
# DevOps Safeguard — Git ignore
# =============================================================================

# Dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# Next.js build output
/.next/
/.next-verify/
/out/
next-env.d.ts

# Production build
/build
/dist

# Environment files — NEVER commit real secrets.
# Only .env.example (placeholders only) is tracked.
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test
!.env.example
/Secret-no-push

# Supabase local
/supabase/.branches
/supabase/.temp
/supabase/.env

# Go backend
/backend/bin/
/backend/tmp/
*.exe
*.out

# Testing / coverage
/coverage
/.nyc_output
/.test-build
/playwright-report
/test-results
/.playwright-cli

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db
*.swp

# Misc
*.pem
*.tsbuildinfo
.vercel
.turbo
